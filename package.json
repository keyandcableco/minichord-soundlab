{
  "name": "minichord-soundlab",
  "version": "1.0.0",
  "description": "Browser-based companion app for the minichord: live play mirror, full settings editor, presets.",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "html-validate index.html",
    "smoke": "node __harness__/smoke.js",
    "test": "node __harness__/run.js > __harness__/out.txt && git diff --no-index __harness__/golden.txt __harness__/out.txt",
    "check": "npm run lint && npm run lint:css && npm run lint:html && npm run test && npm run smoke"
  },
  "license": "CC-BY-NC-4.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "html-validate": "^10.9.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
